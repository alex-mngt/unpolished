# Search engine indexing switch. Only the exact value "true" lets search
# engines index the landing page; anything else keeps the whole site noindex.
# Read at build time: a change takes effect on the next build.
ALLOW_INDEXING=false

# Public origin of the site, e.g. https://example.com. Base of the canonical
# URL, the sitemap and the link preview image URLs. Required when
# ALLOW_INDEXING=true (the build fails without it). Set it on every deployment
# anyway: without it, link previews look for their image on localhost.
SITE_URL=
