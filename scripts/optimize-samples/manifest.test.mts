import { describe, expect, test } from "vitest";

import { renderManifest } from "./manifest.mts";

describe("renderManifest", () => {
  test("spells out each file next to its literal URL, for the bundler", () => {
    expect(renderManifest(["FX_Ah.flac", "FX_hum.flac"])).toBe(
      [
        "// Generated by `pnpm optimize-samples`. Do not edit.",
        "",
        "export const FILES = [",
        '  { fileName: "FX_Ah.flac", url: new URL("./FX_Ah.flac", import.meta.url) },',
        '  { fileName: "FX_hum.flac", url: new URL("./FX_hum.flac", import.meta.url) },',
        "];",
        "",
      ].join("\n"),
    );
  });

  test("breaks an entry too long for one line, as the formatter would", () => {
    expect(renderManifest(["FX_ring alarm_185bpm.flac"])).toContain(
      [
        "  {",
        '    fileName: "FX_ring alarm_185bpm.flac",',
        '    url: new URL("./FX_ring alarm_185bpm.flac", import.meta.url),',
        "  },",
      ].join("\n"),
    );
  });

  test("lists the files in a stable order", () => {
    const manifest = renderManifest(["FX_hum.flac", "FX_Ah.flac"]);
    expect(manifest.indexOf("FX_Ah.flac")).toBeLessThan(
      manifest.indexOf("FX_hum.flac"),
    );
  });

  test("still exports a list without any sample", () => {
    expect(renderManifest([])).toContain("export const FILES = [];");
  });
});
