import { byName } from "./sources.mts";

const PRINT_WIDTH = 80;

// Laid out as the formatter would, so that formatting the file changes nothing.
const entry = (fileName: string) => {
  const name = JSON.stringify(fileName);
  const url = `new URL(${JSON.stringify(`./${fileName}`)}, import.meta.url)`;
  const line = `  { fileName: ${name}, url: ${url} },`;
  return line.length <= PRINT_WIDTH
    ? line
    : ["  {", `    fileName: ${name},`, `    url: ${url},`, "  },"].join("\n");
};

/**
 * The module listing the FLAC files for the app. The bundler only emits a file
 * whose `new URL` path is a literal, and the emitted URL is hashed: every file
 * name is spelled out, next to its URL.
 */
export const renderManifest = (flacs: string[]): string => {
  const entries = flacs.toSorted(byName).map(entry);
  const list =
    entries.length === 0 ? "[]" : ["[", ...entries, "]"].join("\n");
  return [
    "// Generated by `pnpm optimize-samples`. Do not edit.",
    "",
    `export const FILES = ${list};`,
    "",
  ].join("\n");
};
